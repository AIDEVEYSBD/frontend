data: {"type":"entry","t":5,"kind":"tool.result","node":"register","title":"record.query returned","detail":"","data":{"tool":"record.query","value":{"rows":[{"id":"CSF-GV.OC-01","type":"control","framework":"NIST CSF 2.0","name":"Organizational cybersecurity strategy","requirement":"A cybersecurity strategy exists, is approved, and is reviewed on a cadence.","expected_evidence":"Strategy or policy document with approval and review dates","_backend":"framework"},{"id":"CSF-GV.RR-02","type":"control","framework":"NIST CSF 2.0","name":"Roles and responsibilities","requirement":"Cybersecurity roles, responsibilities and authorities are established and communicated.","expected_evidence":"Role definitions; RACI; policy naming owners","_backend":"framework"},{"id":"CSF-ID.AM-01","type":"control","framework":"NIST CSF 2.0","name":"Asset inventory","requirement":"Hardware and software assets are inventoried and maintained.","expected_evidence":"Inventory extract or CMDB review evidence","_backend":"framework"},{"id":"CSF-PR.AA-01","type":"control","framework":"NIST CSF 2.0","name":"Identity and access management","requirement":"Identities are managed; access follows least privilege with joiner/mover/leaver discipline.","expected_evidence":"Access policy; entitlement review minutes; JML records","_backend":"framework"},{"id":"CSF-PR.AA-05","type":"control","framework":"NIST CSF 2.0","name":"Privileged access","requirement":"Privileged access is restricted, just-in-time where feasible, and reviewed.","expected_evidence":"Privileged access policy; elevation logs; review evidence","_backend":"framework"},{"id":"CSF-PR.DS-11","type":"control","framework":"NIST CSF 2.0","name":"Data backup","requirement":"Backups of data are created, protected, and tested.","expected_evidence":"Backup schedule; restore test report","_backend":"framework"},{"id":"CSF-PR.AT-01","type":"control","framework":"NIST CSF 2.0","name":"Awareness and training","requirement":"Personnel are trained on cybersecurity responsibilities.","expected_evidence":"Training completion report; rollout evidence","_backend":"framework"},{"id":"CSF-DE.CM-01","type":"control","framework":"NIST CSF 2.0","name":"Continuous monitoring","requirement":"Networks and services are monitored to find adverse events.","expected_evidence":"Monitoring coverage statement; alert pipeline evidence","_backend":"framework"},{"id":"CSF-RS-MA-01","type":"control","framework":"NIST CSF 2.0","name":"Incident response execution","requirement":"Incidents are responded to per documented procedures with defined activation.","expected_evidence":"IR runbook; postmortem showing the procedure was followed","_backend":"framework"},{"id":"CSF-RC.RP-01","type":"control","framework":"NIST CSF 2.0","name":"Recovery execution","requirement":"Recovery objectives are defined and exercised.","expected_evidence":"RTO/RPO definitions; restore or failover exercise evidence","_backend":"framework"}],"consulted":[{"backend":"framework","kind":"file","ok":true,"rows":10}]}},"because":["8ec22095b377"],"id":"144516977d5a","tainted":false}

