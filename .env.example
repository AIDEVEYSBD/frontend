# Every setting the console reads. There are two. Never commit real values.
#
# The console serves the pages and nothing else. The platform's service
# answers every /api request, signs people in through Google Identity-Aware
# Proxy and holds every other setting: IAP_AUDIENCE, IAP_ROLE_MAP,
# IAP_SIGNOUT_URL, IAP_JWKS_URL, PUBLIC_API_URL, WORKLOAD_URLS and the rest
# are the service's, in its own .env.example. deploy/console/README.md walks
# through a deployment.

# ───────────── Build time (docker build --build-arg) ─────────────

# Required. The address people open the console at, in full, no trailing
# slash. Compiled into the pages (links to pages, approval links, exported
# records), so the build stops without it. On Cloud Run:
# https://SERVICE-PROJECT_NUMBER.REGION.run.app, or your own domain.
NEXT_PUBLIC_ORIGIN=https://console.example.com

# ───────────── Run time ─────────────

# Required. The service's address as this console's server reaches it:
# scheme, host and port, nothing after. Every /api request and the agent card
# (/.well-known/agent.json) are forwarded there with their headers unchanged.
# Unset, every request is answered 503 with that reason.
BACKEND_ORIGIN=http://agentfactory-service.internal:8080

# Set by the image or the platform; leave them:
# PORT              the port the console listens on (8080 in the image; Cloud Run sets it)
# HOSTNAME=0.0.0.0
# NODE_ENV=production
# NEXT_TELEMETRY_DISABLED=1
