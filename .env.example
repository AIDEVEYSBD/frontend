# Every setting the console reads, by name. Copy what you need; never commit real values.
# For the console on its own on Cloud Run, only the first two sections matter.
# deploy/console/README.md walks through the deployment.

# ───────────── 1. Build time (docker build --build-arg) ─────────────

# The address people open the console at, in full, no trailing slash. Compiled
# into the pages, so the build stops without it. On Cloud Run:
# https://SERVICE-PROJECT_NUMBER.REGION.run.app, or your own domain.
NEXT_PUBLIC_ORIGIN=https://agentfactory-console-123456789012.europe-west1.run.app

# 1 (the image's default): a panel that cannot read its data says "Not connected"
# and prints no failure. 0 once a backend is connected.
NEXT_PUBLIC_CONSOLE_QUIET=1

# ───────────── 2. Run time, the console on its own ─────────────

# Required. Signs the console's session cookie. Any long random value
# (openssl rand -hex 32). Keep it in Secret Manager.
AUTH_SECRET=

# Required. Switches Google IAP sign-in on: the audience IAP's assertions carry.
#   Cloud Run:  /projects/PROJECT_NUMBER/locations/REGION/services/SERVICE_NAME
#   GKE:        /projects/PROJECT_NUMBER/global/backendServices/BACKEND_SERVICE_ID
IAP_AUDIENCE=/projects/123456789012/locations/europe-west1/services/agentfactory-console

# Who holds which role. JSON: a key is an email address or "@domain"; the address
# wins over its domain. Roles: platform_admin (everything) and auditor (reads
# everything, changes nothing). Anyone not named has no access.
IAP_ROLE_MAP={"first.last@example.com":"platform_admin","audit.person@example.com":"auditor"}

# Optional. The address of each security workload's own console, where a run is
# set up. JSON keyed by workload: sast, pentest, firewall, threat_hunt. A workload
# left out shows its "Set up a run" button as not live yet.
# WORKLOAD_URLS={"sast":"https://sast.example.com","pentest":"https://pentest.example.com"}

# Optional. Shows a sign-out button that ends the IAP session.
# IAP_SIGNOUT_URL=https://HOST/?gcp-iap-mode=CLEAR_LOGIN_COOKIE

# Optional. A mirror of https://www.gstatic.com/iap/verify/public_key-jwk for a
# network that cannot reach it.
# IAP_JWKS_URL=

# Optional. The IAP API's address, for a private endpoint; used to read who is on
# the console's access list.
# IAP_API_ENDPOINT=

# Optional. Gives a role to everyone the map does not name, for a demo. Leave unset.
# AUTH_DEMO_DEFAULT_ROLE=

# Optional, Vertex AI model list. The console asks the metadata server for the
# project and region; set these only to override (for example when Vertex AI is
# used in a different region from the service).
# GCP_PROJECT=
# REGION=
# Publishers whose models are listed. Default: google,anthropic,meta,mistralai
# VERTEX_PUBLISHERS=
# The Vertex AI API address, for a private endpoint.
# VERTEX_ENDPOINT=

# Optional, only off Google Cloud or for a test. The console uses the workload's
# own service account first; these are the fallbacks, in this order.
# GCP_TOKEN=                         a bearer token handed in (tests only)
# GCP_METADATA_HOST=                 the metadata server's address (GCE_METADATA_HOST also read)
# GCP_CREDENTIALS_FILE=              a credentials file (GOOGLE_APPLICATION_CREDENTIALS also read)
# GOOGLE_CLOUD_PROJECT=              read when GCP_PROJECT is not set
# GOOGLE_CLOUD_REGION=               read when REGION is not set

# ───────────── 3. Set by the image or the platform: leave alone ─────────────

# PORT                       Cloud Run sets it; the console listens on it (8080 by default).
# HOSTNAME=0.0.0.0
# PUBLIC_ORIGIN              the build's NEXT_PUBLIC_ORIGIN, repeated for server code.
# AGENTFACTORY_DB=off        there is no registry database behind a console on its own.
# AGENTFACTORY_RUNTIME_ROOT=/data/runtime   an empty, read-only folder: no runtime files.
# NODE_ENV=production
# NEXT_TELEMETRY_DISABLED=1

# ───────────── 4. Later, when the backend (GKE) is connected ─────────────

# The backend's address as the console's server reaches it. Backend-owned API
# paths are forwarded there.
# BACKEND_ORIGIN=http://backend.internal:8000
# The shared secret the console adds to what it forwards.
# RUNTIME_KEY=
# The registry database the console's own routes read. Set AGENTFACTORY_DB=on
# (anything but "off") and either the connection string or the parts.
# AGENTFACTORY_DB=on
# AGENTFACTORY_DB_DSN=postgres://USER:PASSWORD@HOST:5432/agentfactory
# AGENTFACTORY_DB_HOST=
# AGENTFACTORY_DB_PORT=
# AGENTFACTORY_DB_NAME=
# AGENTFACTORY_DB_USER=
# AGENTFACTORY_DB_PASSWORD=
# The knowledge store (documents and their index), the same way.
# KNOWLEDGE_DB_DSN=
# KNOWLEDGE_DB_HOST=
# KNOWLEDGE_DB_PORT=
# KNOWLEDGE_DB_NAME=
# KNOWLEDGE_DB_USER=
# KNOWLEDGE_DB_PASSWORD=
# Where the runtime's files are, if the console shares a volume with it.
# AGENTFACTORY_RUNTIME_ROOT=
# The console's own address as its server calls itself (assistant, MCP door).
# ASSISTANT_SELF_ORIGIN=http://127.0.0.1:8080
# Hosts runs may reach, comma separated, shown on the Configuration page.
# AF_EGRESS=
# Labels on exported telemetry.
# OTEL_SERVICE_NAME=agent-factory
# OTEL_ENVIRONMENT=
# OTEL_RELEASE=

# ───────────── 5. Not used on this deployment ─────────────
# Read by the code for other deployments. Leave every one unset here.

# A console that proxies its whole API to another host: RUNTIME_ORIGIN
# OpenID Connect sign-in in place of IAP: AUTOX_CLIENT_ID, AUTOX_CLIENT_SECRET, AUTOX_ISSUER
# Sign-in off, role of the local operator (a laptop only): AUTH_LOCAL_ROLE
# Azure AI Foundry as the model gateway: FOUNDRY_ENDPOINT, FOUNDRY_API_KEY, AZURE_AI_KEY
# Models the console's own features call through that gateway: ASSISTANT_MODEL, RAG_MODEL, RAG_JUDGE_MODEL, RERANK_MODEL, RERANK_CROSS_ENCODER
# Azure spend figures: AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_SUBSCRIPTION_ID, AZURE_FOUNDRY_RESOURCE_ID
# Trace export to Langfuse: LANGFUSE_HOST, LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY
